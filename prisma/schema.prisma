generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
  FLAGGED
  INCOMPLETE
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ChannelType {
  WEB
  MOBILE
  MARKETPLACE
  STORE
  PARTNER
}

enum SellingMode {
  RETAIL
  WHOLESALE
}

enum PurchasePolicy {
  INSTANT
  TEAM_VERIFICATION
}

model ProductPrice {
  id         String  @id @default(cuid())
  productId  String
  currencyId String
  amount     Decimal

  product  Product  @relation(fields: [productId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([productId, currencyId]) // One price per currency
}

model Currency {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String // US Dollar, Euro, Emirati Dirham...
  symbol        String // $, €, د.إ
  decimalPlaces Int      @default(2) // 2 for USD/EUR, 0 for JPY, etc.
  isActive      Boolean  @default(true) // Can disable currencies you don't use
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ProductPrice  ProductPrice[]
  variantPrices VariantPrice[]
}

model Channel {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  type        ChannelType
  description String?
  isActive    Boolean     @default(true)
  config      Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  products    Product[]
  orders      Order[]
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phoneNumber   String?
  passwordHash  String?
  name          String?
  role          UserRole   @default(USER)
  preferences   Json?
  profileStatus UserStatus @default(INCOMPLETE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orders        Order[]
  addresses     Address[]
  profile       Profile?
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  company      String?
  companyVat   String?
  companyPhone String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  imageId               String?   @unique
  image                 Image?    @relation("CategoryImage", fields: [imageId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  products              Product[]
  /// Minimum number of packs per wholesale variant. Null until configured.
  wholesaleMinimumPacks Int?
}

model PricePlan {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String               @id @default(uuid())
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  channelId       String?
  channel         Channel?             @relation(fields: [channelId], references: [id])
  seo_title       String
  seo_description String
  seo_keywords    String
  name            String
  slug            String               @unique
  price           Decimal              @db.Decimal(10, 2)
  thumbnailId     String?              @unique
  thumbnail       Image?               @relation("ProductThumbnail", fields: [thumbnailId], references: [id])
  sliderImages    Image[]              @relation("ProductSliderImages")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  comments        Comment[]
  orderItems      OrderItem[]
  productPrices   ProductPrice[]
  sellingModes    ProductSellingMode[]

  @@index([channelId])
}

model ProductSellingMode {
  productId      String
  mode           SellingMode
  purchasePolicy PurchasePolicy
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants       SellableVariant[]

  @@id([productId, mode])
}

model SellableVariant {
  id           String             @id @default(uuid())
  productId    String
  mode         SellingMode
  sellingMode  ProductSellingMode @relation(fields: [productId, mode], references: [productId, mode], onDelete: Cascade)
  name         String
  /// Available for sale when active and stock is positive.
  isActive     Boolean            @default(true)
  /// Individual sale units in retail and complete packs in wholesale.
  stock        Int                @default(0)
  /// Wholesale contents as an array of { name, quantity } objects.
  packContents Json?
  prices       VariantPrice[]
  orderItems   OrderItem[]

  @@unique([id, productId, mode])
  @@index([productId, mode])
}

model VariantPrice {
  variantId  String
  currencyId String
  amount     Decimal
  variant    SellableVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency   Currency        @relation(fields: [currencyId], references: [id])

  @@id([variantId, currencyId])
  @@index([currencyId])
}

model Image {
  id               String    @id @default(ulid())
  url              String
  md               String?
  sm               String?
  altText          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category? @relation("CategoryImage")
  productThumbnail Product?  @relation("ProductThumbnail")
  productSlider    Product?  @relation("ProductSliderImages", fields: [productSliderId], references: [id])
  productSliderId  String?
}

model Comment {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  content   String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model OrderItem {
  id           String           @id @default(uuid())
  itemId       String
  item         Product          @relation(fields: [itemId], references: [id])
  quantity     Int
  price        Decimal
  order        Order?           @relation(fields: [orderId], references: [id])
  orderId      String?
  // Product-only lines retain their original price and quantity. Variant lines
  // capture the sale terms so later catalog edits cannot reinterpret them.
  variantId    String?
  sellingMode  SellingMode?
  variant      SellableVariant? @relation(fields: [variantId, itemId, sellingMode], references: [id, productId, mode], onDelete: Restrict, onUpdate: Restrict)
  variantName  String?
  packContents Json?
  currencyCode String?

  @@index([variantId, itemId, sellingMode])
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PAYMENT_REQUIRED
  PRODUCTION
  PRODUCTION_COMPLETE
  PROCESSING
  SHIPPING
  CANCELLED
  COMPLETED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
  PICKUP
  INTERNATIONAL
  CARGO
}

model Order {
  id             String          @id @default(uuid())
  userId         String
  orderStatus    OrderStatus     @default(PAYMENT_REQUIRED)
  shippingMethod ShippingMethod?
  user           User            @relation(fields: [userId], references: [id])
  channelId      String?
  channel        Channel?        @relation(fields: [channelId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]

  @@index([channelId])
}

enum AddressType {
  BILLING
  SHIPPING
}

model Address {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  street    String
  type      AddressType
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}
